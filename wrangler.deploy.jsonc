{
  // Self-hosted deployment: RealityOS running on *your own* Cloudflare account,
  // with no managed platform in front of it. Use this instead of wrangler.jsonc
  // (which stays as the local-development config) when you want the site to be
  // independent of the managed host.
  //
  // Fill the two REPLACE_WITH_* placeholders before deploying:
  //   REPLACE_WITH_D1_DATABASE_ID  → id printed by `npx wrangler d1 create realityos`
  //   REPLACE_WITH_PUBLIC_ORIGIN   → the Worker origin, e.g.
  //                                  https://realityos.<your-subdomain>.workers.dev
  //
  // Then: npm run build && npm run deploy:cf
  // See docs/DEPLOY-CLOUDFLARE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realityos",
  "main": "dist/worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "realityos",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "FREEBUFF_CLIENT_ID": "84de8b4e-1988-4f88-a8f2-f202418abbe4",
    "FREEBUFF_ISSUER": "https://freebuff.com/oidc",
    "APP_ORIGIN": "REPLACE_WITH_PUBLIC_ORIGIN",
    "PUBLIC_ORIGIN": "REPLACE_WITH_PUBLIC_ORIGIN",
    "AI_PROVIDER": "auto"
  },
  "observability": { "enabled": true }
}
