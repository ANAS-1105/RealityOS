# ─── RealityOS backend (Worker) ───────────────────────────────────────────────
# Sign in with Freebuff (public configuration, no secret). Injected on deploy by
# the hosting platform; the values below are the local development client.
FREEBUFF_CLIENT_ID="your-freebuff-client-id"
FREEBUFF_ISSUER="https://freebuff.com/oidc"
APP_ORIGIN="http://localhost:8787"

# ─── LLM provider (optional) ──────────────────────────────────────────────────
# RealityOS is provider-agnostic: set these to enable the LLM agent pipeline.
# If they are absent the platform runs its deterministic local reasoning core
# (identical workflow, no LLM narrative). Never expose these to the browser.
# Provided as a Worker secret on the hosting platform (Sites → Secrets).
AI_PROVIDER="auto"                     # auto | openai | none
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_VISION_MODEL="gpt-4o-mini"
