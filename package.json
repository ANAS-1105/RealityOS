{
  "name": "realityos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:worker": "node tools/build-worker.mjs",
    "build": "npm run build:web && npm run build:worker",
    "typecheck": "tsc --noEmit",
    "train": "node tools/train-model.mjs",
    "db:local": "wrangler d1 execute realityos --local --file=worker/db/schema.sql",
    "dev:worker": "wrangler dev",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@freebuff/auth": "^0.1.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "motion": "^14.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
